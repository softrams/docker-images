# =============================================================================
# Admiral SSH Network Lockdown Configuration
# =============================================================================
# Location: /etc/ssh/ssh_config.d/99-admiral-network-lockdown.conf
#
# This file restricts SSH connections to allowlisted hosts only.
# It is system-wide (owned by root) so the opencode user cannot modify it.
#
# SECURITY: Uses "Host *" at the end to deny all non-allowlisted hosts
#
# Allowlisted SSH hosts:
#   - github.com (for Terraform modules and git operations)
#   - github.cms.gov (for CMS repositories)
#
# SSH connections are tunneled through the Squid proxy via CONNECT method.
# =============================================================================

# -----------------------------------------------------------------------------
# GitHub (public)
# -----------------------------------------------------------------------------
# Used for: Terraform modules (git@github.com:softrams-iac/...), git operations
Host github.com
    HostName github.com
    User git
    IdentityFile /home/opencode/.ssh/id_ed25519
    StrictHostKeyChecking accept-new
    # Route through Squid proxy via CONNECT tunnel
    ProxyCommand corkscrew egress-proxy 3128 %h %p

# -----------------------------------------------------------------------------
# GitHub Enterprise (CMS)
# -----------------------------------------------------------------------------
# Used for: CMS repositories, internal git operations
Host github.cms.gov
    HostName github.cms.gov
    User git
    IdentityFile /home/opencode/.ssh/id_ed25519
    StrictHostKeyChecking accept-new
    # Route through Squid proxy via CONNECT tunnel
    ProxyCommand corkscrew egress-proxy 3128 %h %p

# -----------------------------------------------------------------------------
# DENY ALL OTHER SSH HOSTS
# -----------------------------------------------------------------------------
# This catch-all rule blocks SSH connections to any host not explicitly
# listed above. The ProxyCommand exits with error, preventing connection.
#
# IMPORTANT: This MUST be the last Host block in the config file.
# =============================================================================
Host *
    # Block all other SSH connections with a clear error message
    ProxyCommand /bin/sh -c 'echo "SSH BLOCKED: Connection to %h not allowed by Admiral network policy" >&2; exit 1'
